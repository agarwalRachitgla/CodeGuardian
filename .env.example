# CodeGuardian AI - Environment Variables
# Copy this file to .env and fill in your API keys

# Primary AI Provider - Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Fallback AI Provider - Google Gemini (https://aistudio.google.com/apikey)
# You can provide multiple keys separated by commas for automatic rotation,
# or specify a single key. Ensure one of the keys is valid.
GEMINI_API_KEYS=key1,key2,key3,key4
